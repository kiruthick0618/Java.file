//K pattern
import java.util.Scanner;

public class KPattern {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the number of rows for the 'K' pattern: ");
        int rows = sc.nextInt();
        for (int i = 0; i < rows; i++) {
            System.out.print("*"); 
            for (int j = 0; j < rows; j++) {
                if (i + j == rows / 2 || i - j == rows / 2) {
                    System.out.print("*");
                } else {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
        sc.close();
    }
}
